USE ../knowledge/draft-knowledge.flow

DO Resolve the selected temporary pr draft from @request or conversation
    under @draft_rules, without Jira, Git readiness, or tool checks. Return an
    object with selection_ready, project, ticket_id, path, and owned_directory;
    use NULL for missing selection details. AS selected

IF @selected.selection_ready != TRUE
    ASK "Provide the project, Jira ticket, and exact draft path to remove:" AS selection_input
    DO Resolve @selection_input under @draft_rules and return the completed
        selection object. AS selected

IF @selected.selection_ready != TRUE
    RETURN "Draft cleanup stopped because the selection is incomplete."

DO Remove only @selected.path and its empty owned directory under @draft_rules.
    Done permits an incomplete draft and never publishes. Forget only the cleaned
    record and return the cleanup result including any retained path. AS cleanup_result

PRINT Report @cleanup_result and that nothing was published briefly.
