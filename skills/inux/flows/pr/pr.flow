do Infer the intention after /inux pr or the equivalent plain-language PR request
    without inspecting project or tools.
    Return an object with unchanged request and mode: "prepare" for creating/drafting, including
    a target-only request; "refine" for title/description edits; "explain";
    "publish" only for explicit publication; or "done" for finishing/discarding
    without publication. Use null for missing, unsupported, conflicting, or
    ambiguous requests. as @route

set request = @route.request
set mode = @route.mode

if @mode == "prepare"
    use pr-prepare.flow
    return

if @mode == "refine"
    use pr-refine.flow
    return

if @mode == "explain"
    use pr-explain.flow
    return

if @mode == "publish"
    use pr-publish.flow
    return

if @mode == "done"
    use pr-done.flow
    return

return "Usage: /inux pr [request]. Request prepare, refine, explain, publish, or done."
