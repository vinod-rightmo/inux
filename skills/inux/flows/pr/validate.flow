DO Inspect branch, HEAD, remotes, and active Git operation state once for
    @project. Return an object with current_branch, checked_head, repository,
    push_remote, and target_remote. Resolve operation markers through Git for
    worktrees. AS git_state

SET current_branch = @git_state.current_branch
SET checked_head = @git_state.checked_head
SET repository = @git_state.repository
SET push_remote = @git_state.push_remote
SET target_remote = @git_state.target_remote

RUN git -C @project status --porcelain=v1 --untracked-files=all --ignore-submodules=none AS status_result

DO Verify @git_state has an attached HEAD, @status_result.stdout represents a
    clean index and tree including untracked files and submodules, and no merge,
    rebase, cherry-pick, or revert is active.

RUN git -C @project check-ref-format --branch @current_branch AS branch_format

DO Verify @current_branch follows @project_rules and contains the exact
    @ticket_id. When no repository rule overrides it, require
    <type>/<TICKET-ID>-<lowercase-kebab-description>, an allowed type, and 1–6
    lowercase letter or digit description words. Do not use ix or a generated
    validator.

DO Verify @current_branch is a task branch distinct from @target.

RUN git -C @project fetch @target_remote @target AS fetch_result

DO Resolve the fetched @target on @target_remote. Return an object with
    target_ref and target_revision. Do not use a fallback base or ref. AS target_state

SET target_ref = @target_state.target_ref
SET target_revision = @target_state.target_revision

RUN git -C @project merge-base @target_ref HEAD AS merge_base_result

DO Trim only the terminal newline from @merge_base_result.stdout and return the
    resulting commit ID. AS merge_base

DO Verify @merge_base is not empty. Fail PR validation when the task branch and
    target have no shared ancestry.

DO Join @target_ref and ..HEAD into one literal revision range argument. AS commit_range

RUN git -C @project log --reverse "--format=%H%n%B%x00" @commit_range AS commits_result

DO Parse every SHA and full commit message from @commits_result.stdout,
    including merges. Preserve message whitespace except record separators and
    one terminal newline. Verify the range is nonempty and every message follows
    @project_rules; otherwise require one line
    <TICKET-ID>: <Capitalized present-tense summary> using @ticket_id exactly
    once, with no body, extra prefix, or duplicate ticket. Return the ordered
    messages and SHAs. AS checked_messages
