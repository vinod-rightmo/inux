DO Classify only the user's request after /inux estimate. Return an object with
    request containing the unchanged request and mode equal to "generate" for
    drafting or creating, "improve" for editing or refining, "explain" for
    explaining, "publish" only for explicit publication, or NULL for missing,
    unsupported, conflicting, or ambiguous intent. Do not inspect the project,
    task files, or tools. AS route

SET request = @route.request
SET mode = @route.mode

IF @mode == NULL
    RETURN "Error: cannot classify estimate request. Usage: /inux estimate [request]. Request generate, improve, explain, or publish; for example: /inux estimate improve the reasons."

IF @mode != "generate" AND @mode != "improve" AND @mode != "explain" AND @mode != "publish"
    RETURN "Error: unsupported estimate action."

DO Resolve the absolute project and active .inux/ticket.md and estimate.md paths.
    Require both files without resetting the task. Return an object with project,
    ticket_path, and estimate_path. AS files

SET project = @files.project
SET ticket_path = @files.ticket_path
SET estimate_path = @files.estimate_path

DO Read @ticket_path and @estimate_path together. Reject a supplied ticket-ID
    mismatch. Return an object with ticket_id, saved_estimate, and
    estimate_is_empty. AS estimate_state

SET ticket_id = @estimate_state.ticket_id
SET saved_estimate = @estimate_state.saved_estimate
SET estimate_is_empty = @estimate_state.estimate_is_empty

IF @mode == "improve" AND @estimate_is_empty == TRUE
    SET mode = "generate"

IF @mode == "generate"
    USE estimate/write.flow
    RETURN

IF @mode == "improve"
    USE estimate/write.flow
    RETURN

IF @mode == "explain"
    USE estimate/explain.flow
    RETURN

USE estimate/publish.flow
