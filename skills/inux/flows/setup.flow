# x-release-please-start-version
SET default_target = "1.0.0"
# x-release-please-end

SET default_repository = "vinod-rightmo/inux"
SET gh_releases_api = "https://api.github.com/repos/cli/cli/releases"
SET acli_source = "https://developer.atlassian.com/cloud/acli/guides/download-supported-packages/"

DO Resolve setup inputs. Return an object with windows TRUE only on Windows;
    target from the explicit ix-version override or @default_target; repository
    from the explicit override or @default_repository; storage_override from
    the explicit storage root or NULL; and requested_gh_version and
    requested_acli_version from explicit overrides or NULL. AS setup_request

SET windows = @setup_request.windows
SET target = @setup_request.target
SET repository = @setup_request.repository
SET storage_override = @setup_request.storage_override
SET requested_gh_version = @setup_request.requested_gh_version
SET requested_acli_version = @setup_request.requested_acli_version

IF @windows == TRUE
    USE setup/windows.flow
    RETURN

USE setup/unix.flow
