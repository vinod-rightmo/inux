DO Classify only the user's request after /inux pr. Return an object with request
    containing the unchanged request and mode equal to "prepare" for creating or
    drafting a PR, including a target-only request, "refine" for editing its
    title or description, "explain" for explaining, "publish" only for explicit
    publication, or NULL for missing, unsupported, conflicting, or ambiguous
    intent. Do not inspect the project, task files, or tools. AS route

SET request = @route.request
SET mode = @route.mode

IF @mode == NULL
    RETURN "Error: cannot classify PR request. Usage: /inux pr [request]. Request prepare, refine, explain, or publish; for example: /inux pr improve the title."

IF @mode != "prepare" AND @mode != "refine" AND @mode != "explain" AND @mode != "publish"
    RETURN "Error: unsupported PR action."

IF @mode == "publish"
    DO Verify that @request explicitly requests PR publication.

DO Resolve the absolute project and active .inux/ticket.md and pr.md paths.
    Require ticket.md and pr.md without resetting the task. Read the active
    ticket ID from the first heading and reject a supplied-ID mismatch. Return
    an object with project, ticket_path, pr_path, and ticket_id. AS files

SET project = @files.project
SET ticket_path = @files.ticket_path
SET pr_path = @files.pr_path
SET ticket_id = @files.ticket_id

DO Read applicable project AGENTS.md rules and explicit user naming overrides.
    Return them as rules; old conversation history must not override current
    rules. AS project_rules

IF @mode == "prepare"
    USE pr/prepare.flow
    RETURN

IF @mode == "refine"
    USE pr/refine.flow
    RETURN

IF @mode == "explain"
    USE pr/explain.flow
    RETURN

USE pr/publish.flow
